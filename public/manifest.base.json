{
  "id": "/pwa",
  "name": "Nexus Social",
  "short_name": "Nexus",
  "description": "Professional Social Networking Platform",
  "start_url": "/?source=pwa",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#0a0a0b",
  "orientation": "portrait",
  "scope": "/",
  "lang": "en",
  "categories": ["social", "lifestyle"],
  "handle_links": "preferred",
  "icons": [
    {
      "src": "/images/icons/nexus-icon-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/nexus-icon-192-maskable.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/images/icons/nexus-icon-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/nexus-icon-512-maskable.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/feed-mobile.webp",
      "sizes": "540x720",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Home Feed"
    },
    {
      "src": "/screenshots/chat-mobile.webp",
      "sizes": "540x720",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Chat"
    },
    {
      "src": "/screenshots/feed-desktop.webp",
      "sizes": "1280x720",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Home Feed — Desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "New Post",
      "short_name": "Post",
      "description": "Create a new post",
      "url": "/?action=new-post&source=shortcut",
      "icons": [{ "src": "/images/icons/nexus-icon-192.png?v=3", "sizes": "192x192" }]
    },
    {
      "name": "Messages",
      "short_name": "Chat",
      "description": "Open your messages",
      "url": "/chat?source=shortcut",
      "icons": [{ "src": "/images/icons/nexus-icon-192.png?v=3", "sizes": "192x192" }]
    },
    {
      "name": "Notifications",
      "short_name": "Alerts",
      "description": "View your notifications",
      "url": "/notifications?source=shortcut",
      "icons": [{ "src": "/images/icons/nexus-icon-192.png?v=3", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "media", "accept": ["image/*", "video/*"] }]
    }
  }
}
