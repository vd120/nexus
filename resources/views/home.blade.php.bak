<style>
/* Base Navigation Actions Wrapper */
.nav-actions-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
}

/* Header brand visibility on scroll - Optimized */
.nav-brand-wrapper {
    position: relative;
    display: inline-block;
}

.nav-brand-text {
    display: inline-block;
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    text-shadow: 0 0 10px rgba(255,255,255,0.5), 0 0 20px rgba(255,255,255,0.3);
    will-change: opacity, transform;
}

/* Hero nexus title - Optimized fade */
.hero-nexus-title {
    opacity: 1;
    will-change: opacity, transform;
}

.hero-nexus-title.faded,
.hero-subtitle.faded {
    opacity: 0 !important;
    transform: translateY(-10px) !important;
    pointer-events: none;
}

/* Video Fade-in controlled by JS */
.hero-bg-video video {
    opacity: 0;
    transition: none;
}

.hero-bg-video video.video-loaded {
    animation: videoFadeIn 1.5s ease-in-out forwards;
}

/* Light Theme Video Fade-in */
html[data-theme="light"] .hero-bg-video video.video-loaded {
    animation: videoFadeIn 2.5s ease-in-out forwards;
}

@keyframes videoFadeIn {
    0% { opacity: 0; filter: brightness(0.5); }
    100% { opacity: 1; filter: brightness(1); }
}

/* Theme-specific logo visibility */
html[data-theme="light"] .logo-white { display: none !important; }
html[data-theme="light"] .logo-black { display: block !important; }

html[data-theme="dark"] .logo-white { display: block !important; }
html[data-theme="dark"] .logo-black { display: none !important; }

/* Default fallback */
.logo-white { display: block; }
.logo-black { display: none; }

/* Mobile Responsiveness Improvements */
@media (max-width: 768px) {
    .hero {
        height: 100svh; /* Better viewport handling for mobile browsers */
        min-height: -webkit-fill-available;
    }
    
    .hero-bg-video video {
        width: 100%;
        height: 100%;
        object-position: 65% center; /* Softer left alignment for better mobile framing */
    }

    .hero-content h1 {
        font-size: clamp(3.2rem, 13vw, 4.8rem) !important;
        margin-bottom: 12px;
        letter-spacing: -0.04em;
    }

    .hero-content h2 {
        font-size: 1.1rem !important;
        line-height: 1.5;
        max-width: 260px;
        margin: 0 auto 35px;
        opacity: 0.9;
    }

    nav {
        /* Ultimate fix for mobile backdrop-filter */
        position: fixed !important;
        top: 15px !important;
        left: 3% !important;
        width: 94% !important;
        z-index: 99999 !important;
        
        /* Make background extremely transparent to let the blur show */
        background: rgba(20, 20, 25, 0.15) !important;
        
        /* Hardware acceleration */
        transform: translateZ(0);
        -webkit-transform: translateZ(0);
        
        /* The Blur */
        backdrop-filter: blur(35px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(35px) saturate(180%) !important;
        
        border-radius: 100px !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3) !important;
        padding: 6px 12px !important;
    }

    html[data-theme="light"] nav {
        background: rgba(255, 255, 255, 0.2) !important;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05) !important;
    }

    .nav-container {
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: transparent !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        border: none !important;
        box-shadow: none !important;
    }

    .nav-actions-wrapper {
        gap: 12px !important;
    }

    .brand-logo {
        height: 32px !important;
    }

    .scroll-arrow {
        bottom: 40px !important;
    }
}

/* Atmospheric Lightning Effect */
.lightning-flash {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0) 75%);
    opacity: 0;
    mix-blend-mode: screen;
    will-change: opacity, background;
}

html[data-theme="light"] .lightning-flash {
    mix-blend-mode: soft-light;
}
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
@vite(['resources/js/legacy/home.js'])

<script defer>
// Optimized scroll handler - no lag
let scrollTimeout;
let lastKnownScrollPosition = 0;
let ticking = false;

function updateNavVisibility(scrollPos, triggerPoint) {
    const heroNexusTitle = document.querySelector('.hero-nexus-title');
    const heroSubtitle = document.querySelector('.hero-subtitle');

    if (heroNexusTitle) {
        if (scrollPos > triggerPoint) {
            heroNexusTitle.classList.add('faded');
        } else {
            heroNexusTitle.classList.remove('faded');
        }
    }

    if (heroSubtitle) {
        if (scrollPos > triggerPoint) {
            heroSubtitle.classList.add('faded');
        } else {
            heroSubtitle.classList.remove('faded');
        }
    }
}

window.addEventListener('scroll', function() {
    lastKnownScrollPosition = window.scrollY;
    
    if (!ticking) {
        window.requestAnimationFrame(function() {
            const heroSection = document.querySelector('.hero');
            if (heroSection) {
                const triggerPoint = heroSection.offsetHeight * 0.5;
                updateNavVisibility(lastKnownScrollPosition, triggerPoint);
            }
            ticking = false;
        });
        ticking = true;
    }
}, { passive: true }); // Passive listener for better scroll performance

// Real-time translation logic
window.nexusTranslations = {
    'en': {
        ... @json(__('home', [], 'en')),
        ... {
            'select_language': @json(__('messages.select_language', [], 'en')),
            'language': @json(__('messages.language', [], 'en'))
        }
    },
    'ar': {
        ... @json(__('home', [], 'ar')),
        ... {
            'select_language': @json(__('messages.select_language', [], 'ar')),
            'language': @json(__('messages.language', [], 'ar'))
        }
    }
};

window.switchRealTimeLanguage = function(locale) {
    const data = window.nexusTranslations[locale];
    if (!data) return;

    // Update HTML attributes
    document.documentElement.setAttribute('lang', locale);
    document.documentElement.setAttribute('dir', locale === 'ar' ? 'rtl' : 'ltr');

    // Update all translatable elements
    document.querySelectorAll('[data-t]').forEach(el => {
        const key = el.getAttribute('data-t').split('.').pop();
        const type = el.getAttribute('data-t-type') || 'text';
        const value = data[key];

        if (value) {
            if (type === 'html') {
                el.innerHTML = value;
            } else if (type === 'title') {
                document.title = 'Nexus — ' + value;
            } else if (type === 'aria') {
                el.setAttribute('aria-label', value);
            } else {
                el.textContent = value;
            }
        }
    });

    // Update Language Switcher UI (Pill Toggle)
    document.querySelectorAll('.lang-option-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-loc-btn') === locale);
    });

    // Dispatch resize event to fix any GSAP/ScrollTrigger offsets
    window.dispatchEvent(new Event('resize'));
    
    // Background request to update session/cookie
    fetch(`/lang/${locale}`, {
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        }
    }).catch(err => console.error('Failed to update session locale:', err));
};
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const heroVideo = document.getElementById('heroVideo');
    const introWrapper = document.getElementById('intro-wrapper-id');
    
    let videoIsReady = false;
    let minTimeElapsed = false;
    let isRevealed = false;

    // Minimum time for intro
    setTimeout(() => {
        minTimeElapsed = true;
        tryReveal();
    }, 1500);

    function onVideoReady() {
        if (videoIsReady) return;
        videoIsReady = true;
        tryReveal();
    }

    if (heroVideo) {
        heroVideo.addEventListener('canplaythrough', onVideoReady);
        if (heroVideo.readyState >= 3) onVideoReady();
        // Fallback for video
        setTimeout(onVideoReady, 5000);
    } else {
        onVideoReady();
    }

    function tryReveal() {
        if (videoIsReady && minTimeElapsed && !isRevealed) {
            isRevealed = true;
            
            // 1. Play video
            if (heroVideo) {
                heroVideo.play().catch(e => console.debug(e));
                heroVideo.classList.add('video-loaded');
            }

            // 2. Fade out intro
            if (introWrapper) {
                introWrapper.classList.add('fade-out');
                setTimeout(() => introWrapper.remove(), 800);
            }

            // 3. Show content via CSS class on body
            document.body.classList.add('content-loaded');
            
            // 4. Initialize GSAP scroll animations for other sections
            if (typeof window.initGSAP === 'function') {
                window.initGSAP(true);
            } else {
                // Fallback if home.js is still loading
                let retries = 0;
                const checkGSAP = setInterval(() => {
                    if (typeof window.initGSAP === 'function' || retries > 30) {
                        if (typeof window.initGSAP === 'function') window.initGSAP(true);
                        clearInterval(checkGSAP);
                    }
                    retries++;
                }, 100);
            }

            // Force a resize for any layout calcs
            window.dispatchEvent(new Event('resize'));
        }
    }

    // Existing Video Loop logic - simplified
    if (heroVideo) {
        heroVideo.addEventListener('timeupdate', function() {
            if (heroVideo.currentTime > heroVideo.duration - 0.5) {
                heroVideo.style.opacity = 0;
            } else if (heroVideo.currentTime < 0.3) {
                heroVideo.style.opacity = 1;
            }
        });
    }

    // Atmospheric Lightning Logic (Existing logic)
    const initLightning = () => {
        const hero = document.querySelector('.hero');
        const video = document.getElementById('heroVideo');
        const overlay = document.querySelector('.lightning-flash');
        const videoOverlay = document.querySelector('.hero-bg-overlay');
        if (!hero || !video || !overlay) return;

        let isHeroVisible = false;
        let lightningTimeout = null;
        let activeTimeline = null;

        const strike = () => {
            if (!isHeroVisible) return;
            if (activeTimeline) activeTimeline.kill();

            activeTimeline = gsap.timeline({
                onComplete: () => {
                    activeTimeline = null;
                    if (isHeroVisible) {
                        lightningTimeout = setTimeout(strike, Math.random() * 2000 + 500);
                    }
                }
            });

            const xPos = Math.random() * 100;
            const colors = ['rgba(255, 255, 255, 0.9)', 'rgba(220, 240, 255, 0.9)', 'rgba(240, 230, 255, 0.9)', 'rgba(255, 255, 240, 0.9)'];
            const selectedColor = colors[Math.floor(Math.random() * colors.length)];
            
            gsap.set(overlay, { 
                background: `radial-gradient(circle at ${xPos}% 0%, ${selectedColor} 0%, rgba(255, 255, 255, 0) 85%)` 
            });

            activeTimeline.to(overlay, { opacity: 0.15, duration: 0.02, repeat: 3, yoyo: true })
              .to(video, { filter: 'brightness(3) contrast(1.4)', duration: 0.02, repeat: 3, yoyo: true }, 0);

            const isMobile = window.innerWidth <= 768;
            const strikePower = (Math.random() > 0.5 ? 0.85 : 0.5) * (isMobile ? 0.8 : 1); 
            const videoBright = (strikePower > 0.5 ? 10 : 5) * (isMobile ? 0.9 : 1); 

            activeTimeline.to(overlay, { opacity: strikePower, duration: 0.04 }, "+=0.01")
              .to(video, { filter: `brightness(${videoBright}) contrast(1.8) saturate(1.7)`, duration: 0.04 }, "<")
              .to(videoOverlay, { opacity: 0.02, duration: 0.04 }, "<") 
              .to(".hero-content", { y: isMobile ? -3 : -6, x: isMobile ? 3 : 6, duration: 0.02, repeat: 4, yoyo: true }, "<");

            if (strikePower > 0.6) {
                activeTimeline.to(overlay, { background: 'white', opacity: strikePower * 0.4, duration: 0.02, repeat: 1, yoyo: true }, "<");
            }

            const restrikeCount = Math.floor(Math.random() * 3) + 2;
            for(let i = 0; i < restrikeCount; i++) {
                const rPower = strikePower * (0.3 + Math.random() * 0.4);
                activeTimeline.to(overlay, { opacity: rPower, duration: 0.03 + (i * 0.01) }, `+=${0.02 + (i * 0.02)}`)
                  .to(video, { filter: `brightness(${videoBright * 0.5}) contrast(1.5)`, duration: 0.03 }, "<")
                  .to(overlay, { opacity: 0.1, duration: 0.04 });
            }

            activeTimeline.to(overlay, { opacity: 0, duration: 1.2, ease: "power4.out" })
              .to(video, { filter: 'brightness(1) contrast(1) saturate(1)', duration: 1.2, ease: "power4.out" }, "-=1.2")
              .to(videoOverlay, { opacity: 1, duration: 1.2, ease: "power4.out" }, "-=1.2")
              .to(".hero-content", { y: 0, x: 0, duration: 0.6 }, "-=1.2");
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    isHeroVisible = true;
                    if (!lightningTimeout && !activeTimeline) strike();
                } else {
                    isHeroVisible = false;
                    if (lightningTimeout) { clearTimeout(lightningTimeout); lightningTimeout = null; }
                    if (activeTimeline) { activeTimeline.kill(); activeTimeline = null; gsap.set(overlay, { opacity: 0 }); gsap.set(video, { filter: 'brightness(1) contrast(1) saturate(1)' }); gsap.set(videoOverlay, { opacity: 1 }); gsap.set(".hero-content", { y: 0, x: 0 }); }
                }
            });
        }, { threshold: 0.01 });

        observer.observe(hero);
    };

    initLightning();
});
</script>
</body>
</html>
