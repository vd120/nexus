APP_NAME="Nexus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://nexusocial.qzz.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIES=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# Cloudflare R2 CDN Storage (optional)
# ============================================
# Set MEDIA_DISK=s3 to store all uploads on R2 instead of local disk.
# Leave MEDIA_DISK=public (default) to keep files on local storage.
#
# Setup:
#   1. Create a free R2 bucket at dash.cloudflare.com → R2
#   2. Enable "Public Access" on the bucket (no per-object ACL needed)
#   3. Create an R2 API token with Object Read & Write permissions
#   4. Fill in the values below and set MEDIA_DISK=s3
MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=nexus-media
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_URL=https://<your-r2-public-domain>
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# Cloudflared Tunnel Configuration
# ============================================
# These are automatically set by start-tunnel.sh
# APP_URL_EXTERNAL is used for OAuth callbacks when using tunnel
APP_URL_EXTERNAL=https://nexusocial.qzz.io

# ============================================
# Google OAuth Configuration
# ============================================
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nexusocial.qzz.io/auth/google/callback
VIRUSTOTAL_API_KEY= # Get free API key from https://www.virustotal.com

# Socket.IO Configuration
SOCKET_IO_PORT=3001
SOCKET_IO_URL=https://nexusocial.qzz.io
SOCKET_INTERNAL_SECRET=base64:Ru++fN0GMbvP11ftAFVcZ/jieWYrrTFy37BNj4L+MMI=

# Redis URL for Socket.IO adapter (enables horizontal scaling)
# Uses the same Redis instance as Laravel cache/sessions
REDIS_URL=redis://127.0.0.1:6379
